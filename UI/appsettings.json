{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "CookieAuth": "Warning"
    },
    "PerNamespaceLogLevels": {
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error",
      "System": "Warning",
      "UI": "Information",
      "Business": "Information",
      "UI.Controllers.AccountController": "Warning",
      "Business.Services.SecurityEventLogger": "Information",
      "Business.Filters.ExceptionLoggingFilter": "Error",
      "Business.Logging.RateLimitEventLogger": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
      "AutoMapper": "Error"
    },
    "LogFilePath": "Logs/security-{Date}.txt",
    "RedactSensitiveData": true,
    "RequestResponseLogging": {
      "Enabled": false,
      "LogRequestBody": false,
      "LogResponseBody": false
    },
    "ExceptionLogging": {
      "Enabled": true
    },
    "EntityFrameworkLogging": {
      "Enabled": false
    },
    "SecurityEventFilter": {
      "IncludeLogLevels": [ "Information", "Warning", "Error", "Fatal" ],
      "IncludeNamespaces": [
        "UI.Controllers.AccountController",
        "Business.Services.SecurityEventLogger",
        "Business.Logging.RateLimitEventLogger",
        "Business.Filters.ExceptionLoggingFilter"
      ]
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ShippingConnection": ""
  },
  "ApiSettings": {
    "BaseUrl": "https://localhost:7228"
  },
  "JwtSettings": {
    "SecretKey": ""
  },
  "SendGrid": {
    "ApiKey": "",
    "FromEmail": "sami.i.amarah@gmail.com",
    "FromName": "MyShipping Support"
  },
  "PaymentGateways": {
    "DefaultGateway": "Stripe",
    "Currency": "USD",
    "CaptureMethod": "automatic",
    "Stripe": {
      "Enabled": true,
      "PublishableKey": "",
      "SecretKey": "",
      "WebhookSecret": "whsec_YOUR_STRIPE_WEBHOOK_SECRET",
      "Environment": "Test",
      "ApiVersion": null
    },
    "PayPal": {
      "Enabled": true,
      "ClientId": "",
      "ClientSecret": "",
      "WebhookId": "01A68034B2206314R",
      "Environment": "Sandbox",
      "BaseUrl": null
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/security-.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "ShippingConnection",
          "tableName": "Log",
          "schemaName": "dbo",
          "autoCreateSqlTable": false,
          "batchPostingLimit": 100,
          "batchPeriod": "00:00:10",
          "restrictedToMinimumLevel": "Information"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "MyShipping.UI"
    }
  }
}








