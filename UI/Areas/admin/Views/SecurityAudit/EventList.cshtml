@model IEnumerable<DataAccessLayer.Models.SecurityAuditLog>

@{
    ViewData["Title"] = ViewBag.ViewTitle ?? "Security Events";
    var paginationInfo = ViewBag.PaginationInfo as UI.Models.PaginationInfo;
    var filterType = ViewBag.FilterType as string;
    var filterValue = ViewBag.FilterValue as string;
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-12">
            <h2>@ViewData["Title"]</h2>
            @if (!string.IsNullOrEmpty(filterType))
            {
                <p class="text-muted">
                    Filtered by <strong>@filterType</strong>: <code>@filterValue</code>
                    <a href="@Url.Action("Index", "SecurityAudit", new { area = "admin" })" class="link-secondary">
                        Clear Filter
                    </a>
                </p>
            }
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="content-wrapper">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">📋 Event Details</h5>
                                <small class="text-muted">
                                    Page @paginationInfo.Page of @paginationInfo.TotalPages
                                    (@paginationInfo.TotalCount total events)
                                </small>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 130px;">Time</th>
                                        <th style="width: 120px;">Event Type</th>
                                        <th style="width: 80px;">Severity</th>
                                        <th style="width: 150px;">Email</th>
                                        <th style="width: 100px;">IP Address</th>
                                        <th>Description</th>
                                        <th style="width: 120px;">CorrelationId</th>
                                        <th style="width: 90px;">Status</th>
                                        <th style="width: 70px;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var evt in Model)
                                    {
                                        <tr class="@(evt.IsReviewed ? "table-light" : "")">
                                            <td>
                                                <small>@evt.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</small>
                                            </td>
                                            <td>
                                                <code style="font-size: 0.8rem;">@evt.EventType</code>
                                            </td>
                                            <td>
                                                @if (evt.Severity == "Critical")
                                                {
                                                    <span class="badge bg-danger">@evt.Severity</span>
                                                }
                                                else if (evt.Severity == "High")
                                                {
                                                    <span class="badge bg-warning">@evt.Severity</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info">@evt.Severity</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(evt.Email))
                                                {
                                                    <small title="@evt.Email">
                                                        @(evt.Email.Length > 15 ? evt.Email.Substring(0, 15) + "..." : evt.Email)
                                                    </small>
                                                    <br />
                                                    <a href="@Url.Action("ByEmail", "SecurityAudit", new { area = "admin", email = evt.Email })"
                                                       class="link-secondary" style="font-size: 0.75rem;">
                                                        View all
                                                    </a>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">-</small>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(evt.IpAddress))
                                                {
                                                    <a href="@Url.Action("ByIp", "SecurityAudit", new { area = "admin", ipAddress = evt.IpAddress })"
                                                       class="link-secondary">
                                                        <small>@evt.IpAddress</small>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">-</small>
                                                }
                                            </td>
                                            <td>
                                                <small>@evt.Description</small>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(evt.CorrelationId))
                                                {
                                                    <small title="@evt.CorrelationId" class="font-monospace">
                                                        @(evt.CorrelationId.Length > 10 ? evt.CorrelationId.Substring(0, 10) + "..." : evt.CorrelationId)
                                                    </small>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">-</small>
                                                }
                                            </td>
                                            <td>
                                                @if (!evt.IsReviewed)
                                                {
                                                    <span class="badge bg-warning text-dark">⏳ New</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">✓ Reviewed</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="#"
                                                   data-event-id="@evt.Id"
                                                   class="btn btn-sm btn-outline-success review-btn"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#reviewModal"
                                                   title="Mark as reviewed">
                                                    ✓
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- PAGINATION CONTROLS -->
                    @if (paginationInfo.TotalPages > 1)
                    {
                        <nav aria-label="Page navigation" class="mt-4 mb-4">
                            <ul class="pagination justify-content-center">
                                <!-- Previous Button -->
                                @if (paginationInfo.HasPrevious)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@GetPageUrl(1)" aria-label="First">
                                            <span>«</span>
                                        </a>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" href="@GetPageUrl(paginationInfo.PrevPage)" aria-label="Previous">
                                            <span>‹</span>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">«</span>
                                    </li>
                                    <li class="page-item disabled">
                                        <span class="page-link">‹</span>
                                    </li>
                                }

                                <!-- Page Numbers -->
                                @for (int i = paginationInfo.Start; i <= paginationInfo.End; i++)
                                {
                                    @if (i == paginationInfo.Page)
                                    {
                                        <li class="page-item active" aria-current="page">
                                            <span class="page-link">
                                                @i
                                                <span class="visually-hidden">(current)</span>
                                            </span>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@GetPageUrl(i)">@i</a>
                                        </li>
                                    }
                                }

                                <!-- Next Button -->
                                @if (paginationInfo.HasNext)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@GetPageUrl(paginationInfo.NextPage)" aria-label="Next">
                                            <span>›</span>
                                        </a>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" href="@GetPageUrl(paginationInfo.TotalPages)" aria-label="Last">
                                            <span>»</span>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">›</span>
                                    </li>
                                    <li class="page-item disabled">
                                        <span class="page-link">»</span>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">ℹ️ No Events Found</h4>
            <p>There are no security events matching your criteria.</p>
            <hr>
            <a href="@Url.Action("Index", "SecurityAudit", new { area = "admin" })" class="btn btn-primary">
                Back to Dashboard
            </a>
        </div>
    }
</div>

<!-- Review Modal -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reviewModalLabel">✓ Mark Event as Reviewed</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="reviewForm" method="post">
                <div class="modal-body">
                    <input type="hidden" id="eventId" name="eventId" />
                    <div class="mb-3">
                        <label for="adminNotes" class="form-label">Admin Notes (optional)</label>
                        <textarea class="form-control" id="adminNotes" name="adminNotes" rows="3"
                                  placeholder="Add notes about this incident..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">✓ Mark Reviewed</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Handle review button clicks
        document.querySelectorAll('.review-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const eventId = this.dataset.eventId;
                document.getElementById('eventId').value = eventId;
            });
        });

        // Handle form submission
        document.getElementById('reviewForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const eventId = document.getElementById('eventId').value;
            const adminNotes = document.getElementById('adminNotes').value;

            try {
                const response = await fetch(
                    `/admin/security-audit/mark-reviewed/${eventId}`,
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: new URLSearchParams({
                            'adminNotes': adminNotes
                        })
                    }
                );

                if (response.ok) {
                    // Close modal and refresh
                    bootstrap.Modal.getInstance(document.getElementById('reviewModal')).hide();
                    location.reload();
                }
            } catch (error) {
                console.error('Error:', error);
                ShowAlert('error', 'Error marking event as reviewed');
            }
        });
    </script>
}

@{
    string GetPageUrl(int pageNumber)
    {
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var routeValues = new RouteValueDictionary(ViewContext.RouteData.Values)
        {
            { "pageNumber", pageNumber },
            { "pageSize", paginationInfo.PageSize }
        };

        if (!string.IsNullOrEmpty(filterValue))
        {
            routeValues["id"] = filterValue; // For ByType, ByIp, ByEmail routes
        }

        return Url.Action(currentAction, currentController, routeValues);
    }
}













