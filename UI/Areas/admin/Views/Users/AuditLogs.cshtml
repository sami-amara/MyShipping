@model UI.Models.AccountAuditLogsViewModel
@{
    ViewData["Title"] = "Audit Logs";
    var pager = Model.Pager;
    var availableActions = ViewBag.AvailableActions as IEnumerable<string> ?? Array.Empty<string>();
}
<style>
    .filter-control {
        height: 38px !important;
    }
</style>
<div class="container-fluid mt-5">
    <div class="row mb-4">
        <div class="col-lg-8">
            <h2>📋 Account Audit Logs</h2>
            <p class="text-muted">View all account activities for compliance and security monitoring</p>
        </div>
    </div>

    <!-- Search/Filter Form -->
    <div class="card mb-4">
        <div class="card-body">

           

            <form method="get" asp-action="AuditLogs" class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label class="form-label">Search by Email</label>
                    <input type="text"
                           name="email"
                           class="form-control filter-control"
                           placeholder="user@example.com"
                           value="@Model.Email" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Filter by Action</label>
                    <select name="actionFilter" class="form-select filter-control">
                        <option value="">-- All Actions --</option>
                        @foreach (var act in availableActions)
                        {
                            <option value="@act" selected="@(Model.ActionFilter == act)">@act</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label invisible">Search</label>
                    <button type="submit" class="btn btn-primary filter-control w-100">
                        🔍 Search
                    </button>
                </div>

            </form>

        </div>
    </div>

    <!-- Audit Logs Table -->
    @if (Model.Paged.Items.Any())
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Time</th>
                        <th>User Email</th>
                        <th>User Name</th>
                        <th>Action</th>
                        <th>Initiated By</th>
                        <th>IP Address</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Paged.Items)
                    {
                        var actionColor = GetActionBadgeColor(log.Action);
                        <tr>
                            <td>
                                <small>@log.Timestamp.ToString("MMM dd yyyy HH:mm:ss")</small>
                            </td>
                            <td><strong>@log.UserEmail</strong></td>
                            <td>@log.UserName</td>
                            <td>@log.Action</td>
                            <td>@log.InitiatedBy</td>
                            <td>@log.IpAddress</td>
                            <td>
                                <span class="badge @actionColor">
                                    @GetActionBadgeText(log.Action)
                                </span>
                            </td>
                        </tr>
                        @if (!string.IsNullOrWhiteSpace(log.Reason))
                        {
                            <tr class="table-secondary">
                                <td colspan="7">
                                    <small class="text-muted">Reason: @log.Reason</small>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (pager.TotalPages > 1)
        {
            <nav aria-label="Audit logs pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(pager.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-action="AuditLogs" asp-route-page="@pager.PrevPage"
                           asp-route-email="@Model.Email" asp-route-actionFilter="@Model.ActionFilter">Previous</a>
                    </li>
                    @for (var i = pager.Start; i <= pager.End; i++)
                    {
                        <li class="page-item @(i == pager.Page ? "active" : "")">
                            <a class="page-link" asp-action="AuditLogs" asp-route-page="@i"
                               asp-route-email="@Model.Email" asp-route-actionFilter="@Model.ActionFilter">@i</a>
                        </li>
                    }
                    <li class="page-item @(pager.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-action="AuditLogs" asp-route-page="@pager.NextPage"
                           asp-route-email="@Model.Email" asp-route-actionFilter="@Model.ActionFilter">Next</a>
                    </li>
                </ul>
            </nav>
        }

        <p class="text-center text-muted small">
            @pager.TotalCount records, page @pager.Page of @pager.TotalPages
        </p>
    }
    else
    {
        <div class="alert alert-info">
            <strong>ℹ️ No Audit Logs Found</strong><br>
            No account activities match your search criteria.
        </div>
    }
</div>

@functions {
    string GetActionBadgeColor(string action)
    {
        return action switch
        {
            "SuccessfulLogin" => "bg-success",
            "FailedLoginAttempt_InvalidPassword" => "bg-warning",
            "FailedLoginAttempt_LockedOut" => "bg-danger",
            "FailedLoginAttempt_Deactivated" => "bg-secondary",
            "Deactivated" => "bg-danger",
            "Reactivated" => "bg-success",
            "PasswordChanged" => "bg-info",
            "LockedByAdmin" => "bg-danger",
            "UnlockedByAdmin" => "bg-warning",
            _ => "bg-secondary"
        };
    }

    string GetActionBadgeText(string action)
    {
        return action switch
        {
            "SuccessfulLogin" => "✅ Login",
            "FailedLoginAttempt_InvalidPassword" => "❌ Bad Password",
            "FailedLoginAttempt_LockedOut" => "🔒 Locked",
            "FailedLoginAttempt_Deactivated" => "⛔ Deactivated",
            "Deactivated" => "🗑️ Deactivated",
            "Reactivated" => "✅ Reactivated",
            "PasswordChanged" => "🔑 Password",
            "LockedByAdmin" => "👮 Admin Lock",
            "UnlockedByAdmin" => "👮 Admin Unlock",
            _ => action
        };
    }
}






