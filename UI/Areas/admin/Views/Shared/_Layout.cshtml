<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <link rel="stylesheet" href="~/Admin/assets/vendors/mdi/css/materialdesignicons.min.css" />
    <link rel="stylesheet" href="~/Admin/assets/vendors/css/vendor.bundle.base.css" />
    <!-- endinject -->
    <!-- Plugin css for this page -->
    <link rel="stylesheet" href="~/Admin/assets/vendors/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/Admin/assets/vendors/bootstrap-datepicker/bootstrap-datepicker.min.css" />
    <!-- End plugin css for this page -->
    <!-- inject:css -->
    <!-- endinject -->
    <!-- Layout styles -->
    <link rel="stylesheet" href="~/Admin/assets/css/demo_1/style.css" />

    <link rel="stylesheet" href="~/Admin/assets/css/admin-custom.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/Admin/assets/css/shipment-search.css" />

    <link rel="stylesheet" href="~/Admin/assets/css/shipments.css" asp-append-version="true" />
    <!-- End layout styles -->
    <link rel="shortcut icon" href="~/Admin/assets/images/favicon.png" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/MaterialDesign-Webfont/7.4.47/css/materialdesignicons.min.css">
    @* RenderSection("Styles", false) *@
    <!-- local jQuery will be loaded at the end of the body to preserve execution order -->
</head>
<body>

    <div class="container-scroller">
        <!-- partial -->
        <div class="container-fluid page-body-wrapper">
            <nav class="sidebar sidebar-offcanvas" id="sidebar">
                <ul class="nav">
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#apps" aria-expanded="false" aria-controls="apps">
                            <span class="menu-title">@Labels.Configurations</span>
                            <i class="menu-arrow"></i>
                            <i class="mdi mdi-cog-outline menu-icon"></i>
                        </a>
                        <div class="collapse" id="apps">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item">
                                    <a class="nav-link" href="/admin/Home/Index">
                                        <i class="mdi mdi-home-outline me-2"></i>@Labels.Home
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/admin/ShippingTypes">
                                        <i class="mdi mdi-truck me-2"></i>@Labels.ShippingTypes
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/admin/Countries">
                                        <i class="mdi mdi-earth me-2"></i>@Labels.Countries
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/admin/Cities">
                                        <i class="mdi mdi-city me-2"></i>@Labels.Cities
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/admin/SubscriptionPackage">
                                        <i class="mdi mdi-package-variant-closed me-2"></i>@Labels.SubscriptionPackage
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/admin/Shipments/List">
                                        <i class="mdi mdi-package-variant me-2"></i>@Labels.Shipments
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/admin/PaymentTransactions/Index">
                                        <i class="mdi mdi-credit-card me-2"></i>@Labels.PaymentTransactions
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/admin/Users">
                                        <i class="mdi mdi-account-multiple-outline me-2"></i>@Labels.Users
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/admin/security-audit">
                                        <i class="mdi mdi-shield-check-outline me-2"></i>@Labels.SecurityAudit
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/admin/AuditTimeline">
                                        <i class="mdi mdi-history me-2"></i>@Labels.AuditTimeline
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("DeactivatedUsers", "Users", new { area = "admin" })">
                                        <i class="mdi mdi-account-off-outline me-2"></i>@Labels.DeactivatedAccounts
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("AuditLogs", "Users", new { area = "admin" })">
                                        <i class="mdi mdi-clipboard-text-outline me-2"></i>@Labels.AuditLogs
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                </ul>
            </nav>

         
            <div class="main-panel">

                <div class="px-4 pt-3">
                    <button type="button" class="btn btn-light btn-sm d-none d-lg-inline-block" data-toggle="minimize" aria-label="Toggle sidebar">
                        <i class="mdi mdi-menu"></i>
                    </button>
                    <button type="button" class="btn btn-light btn-sm d-lg-none" data-toggle="offcanvas" aria-label="Open menu">
                        <i class="mdi mdi-menu"></i>
                    </button>
                </div>
                @RenderBody()
          
                <footer class="footer">
                    <div class="d-sm-flex justify-content-center justify-content-sm-between">
                        <span class="text-muted text-center text-sm-left d-block d-sm-inline-block">© 2026 MyShipping. All rights reserved.</span>
 
                    </div>
                </footer>
            </div>
    
        </div>
    </div>

    <!-- container-scroller -->
   @Html.AntiForgeryToken()
    <!-- plugins:js -->
    <!-- Styles -->
    <!-- jQuery is provided inside vendor.bundle.base.js for admin pages to avoid duplicate instances -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>


    <link rel="stylesheet" href="~/Admin/assets/vendors/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/Admin/assets/vendors/bootstrap-datepicker/bootstrap-datepicker.min.css" />
    <link rel="stylesheet" href="~/Admin/assets/css/demo_1/style.css" />
 

    <!-- Scripts -->
    <!-- Ensure jQuery is loaded before any jQuery plugins -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>



    <script src="~/Admin/assets/vendors/js/vendor.bundle.base.js"></script>
    <script src="~/Admin/assets/vendors/datatables.net/jquery.dataTables.js"></script>
    <script src="~/Admin/assets/vendors/datatables.net-bs4/dataTables.bootstrap4.js"></script>
    <script src="~/Admin/assets/vendors/chart.js/Chart.min.js"></script>
    <script src="~/Admin/assets/vendors/bootstrap-datepicker/bootstrap-datepicker.min.js"></script>

   
    <script src="~/Admin/assets/js/off-canvas.js"></script>
    <script src="~/Admin/assets/js/hoverable-collapse.js"></script>
    <script src="~/Admin/assets/js/misc.js"></script>
    <script src="~/Admin/assets/js/settings.js"></script>
    <script src="~/Admin/assets/js/todolist.js"></script>
    <script src="~/Admin/assets/js/jquery.cookie.js"></script>
    <script src="~/Admin/assets/js/dashboard.js"></script>



    @await Html.PartialAsync("_ClientResourceScripts")

    <script src="~/App/Shared/showAlert.js"></script>
    <script src="~/Modules/ApiClient.js"></script>
    <script src="~/App/Shared/AlertAdapter.js" defer></script>
    <script src="~/App/Shared/ToastShim.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/shared/js/ScrollHelper.js"></script>
    <script src="~/shared/js/validation.js"></script>
    <script src="~/Modules/ShipmentValidationRules.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>