{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ShippingConnection": ""

  },
  "ClientApp": {
    "BaseUrl": "https://localhost:7065"
  },
  "JwtSettings": {
    "Issuer": "https://localhost:7228",
    "Audience": "https://localhost:7228",
    "AccessTokenExpirationMinutes": 3,
    "RefreshTokenExpirationDays": 7,
    "SecretKey": ""
  },
  "SendGrid": {
    "ApiKey": "",
    "FromEmail": "sami.i.amarah@gmail.com",
    "FromName": "MyShipping Support"
  },
  "PaymentGateways": {
    "DefaultGateway": "Stripe",
    "Currency": "USD",
    "CaptureMethod": "automatic",
    "Stripe": {
      "Enabled": true,
      "PublishableKey": "",
      "SecretKey": "",
      "WebhookSecret": "whsec_YOUR_STRIPE_WEBHOOK_SECRET",
      "Environment": "Test",
      "ApiVersion": null
    },
    "PayPal": {
      "Enabled": true,
      "ClientId": "",
      "ClientSecret": "",
      "WebhookId": "01A68034B2206314R",
      "Environment": "Sandbox"
    }
  },
  "Logging": {
    "PerNamespaceLogLevels": {
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Error",
      "System": "Warning",
      "AutoMapper": "Error"
    }
  },
  "WriteTo": [
    {
      "Name": "File",
      "Args": {
        "path": "Logs/security-.txt",
        "rollingInterval": "Day",
        "restrictedToMinimumLevel": "Information"
      }
    },
    {
      "Name": "File",
      "Args": {
        "path": "Logs/app-.txt",
        "rollingInterval": "Day",
        "restrictedToMinimumLevel": "Information"
      }
    },
    {
      "Name": "MSSqlServer",
      "Args": {
        "connectionString": "ShippingConnection",
        "tableName": "Log",
        "schemaName": "dbo",
        "autoCreateSqlTable": false,
        "batchPostingLimit": 100,
        "batchPeriod": "00:00:10",
        "restrictedToMinimumLevel": "Information"
      }
    }
  ],
  "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
  "Properties": {
    "Application": "MyShipping.WebApi"
  }
}
 

   





