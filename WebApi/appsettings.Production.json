{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ShippingConnection": ""
  },
  "ClientApp": {
    "BaseUrl": "https://your-production-domain.com"
  },
  "JwtSettings": {
    "Issuer": "https://your-production-domain.com",
    "Audience": "https://your-production-domain.com",
    "AccessTokenExpirationMinutes": 5,
    "RefreshTokenExpirationDays": 7,
    "SecretKey": ""
  },
  "SendGrid": {
    "ApiKey": "",
    "FromEmail": "noreply@your-production-domain.com",
    "FromName": "MyShipping Support"
  },
  "PaymentGateways": {
    "DefaultGateway": "Stripe",
    "Currency": "USD",
    "CaptureMethod": "automatic",
    "Stripe": {
      "Enabled": true,
      "PublishableKey": "",
      "SecretKey": "",
      "WebhookSecret": "whsec_YOUR_STRIPE_WEBHOOK_SECRET",
      "Environment": "Live",
      "ApiVersion": null
    },
    "PayPal": {
      "Enabled": true,
      "ClientId": "",
      "ClientSecret": "",
      "WebhookId": "01A68034B2206314R",
      "Environment": "Live"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Error",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/security-.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "ShippingConnection",
          "tableName": "Log",
          "schemaName": "dbo",
          "autoCreateSqlTable": false,
          "batchPostingLimit": 100,
          "batchPeriod": "00:00:10",
          "restrictedToMinimumLevel": "Information"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "MyShipping.WebApi"
    }
  },
  "ApplicationInsights": {
    "InstrumentationKey": ""
  }
}





